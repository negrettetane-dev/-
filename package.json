{
  "name": "zhitu-yunshu",
  "private": true,
  "scripts": {
    "dev:citizen": "pnpm --filter @zhitu/citizen dev",
    "dev:admin": "pnpm --filter @zhitu/management dev",
    "build:citizen": "pnpm --filter @zhitu/citizen build",
    "build:admin": "pnpm --filter @zhitu/management build",
    "build:shared": "pnpm --filter @zhitu/shared build",
    "dev": "concurrently \"pnpm dev:citizen\" \"pnpm dev:admin\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0"
  }
}
